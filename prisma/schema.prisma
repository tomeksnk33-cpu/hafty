// Baza haftów — schemat danych.
// Dokumentacja: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
}

/// Konto osoby logującej się do aplikacji.
model User {
  id                    String   @id @default(cuid())
  /// Zapisywany małymi literami, żeby "Anna" i "anna" były tym samym loginem.
  login                 String   @unique
  name                  String
  /// Format `scrypt:sól:hash`, ten sam co w scripts/haslo.mjs.
  passwordHash          String
  role                  Role     @default(EMPLOYEE)
  /// Pozwala dodawać i edytować hafty, klientów i nici bez uprawnień administratora.
  canManageRealizations Boolean  @default(false)
  /// Dostęp do bazy haftów (realizacje, nici, dziennik). Administrator ma zawsze.
  canUseEmbroidery      Boolean  @default(true)
  /// Dostęp do trasy pralni (/pralnia). Administrator ma zawsze.
  canUseLaundry         Boolean  @default(true)
  /// Dostęp do rejestratora czasu pracy (/rejestrator). Administrator ma zawsze.
  canUseTimeclock       Boolean  @default(true)
  /// Konta się nie usuwa, tylko wyłącza — wpisy w dzienniku muszą zostać.
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  workEntries   WorkEntry[]
  laundryRoutes LaundryRoute[]
}

/// Wpis w dzienniku pracy: kto, którego dnia, przy której realizacji i ile sztuk.
model WorkEntry {
  id              String   @id @default(cuid())
  userId          String
  /// NULL po usunięciu realizacji — wpis zostaje, a nazwę bierzemy z `realizationName`.
  realizationId   String?
  /// Nazwa realizacji z chwili wpisu, żeby rozliczenie przetrwało jej usunięcie.
  realizationName String
  workDate        DateTime @db.Date
  quantity        Int
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  realization Realization? @relation(fields: [realizationId], references: [id], onDelete: SetNull)

  @@index([userId, workDate])
  @@index([workDate])
  @@index([realizationId])
}

/// Klient, dla którego wykonywane są hafty.
model Client {
  id        String   @id @default(cuid())
  name      String
  company   String?
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  realizations Realization[]

  @@index([name])
}

/// Pozycja katalogu nici — producent + numer jednoznacznie identyfikują nić.
model Thread {
  id        String   @id @default(cuid())
  brand     String
  number    String
  colorName String?
  /// Kolor w formacie #rrggbb, tylko do podglądu na liście.
  hex       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  realizations RealizationThread[]
  markers      ThreadMarker[]

  @@unique([brand, number])
  @@index([number])
  @@index([colorName])
}

/// Pojedyncza realizacja (wykonany haft).
model Realization {
  id          String   @id @default(cuid())
  name        String
  executedAt  DateTime @db.Date
  clientId    String?
  productType String?
  widthMm     Int?
  heightMm    Int?
  stitchCount Int?
  quantity    Int      @default(1)
  /// Cena jednostkowa w groszach. Wartość realizacji = unitPriceGr * quantity.
  unitPriceGr Int?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client      Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  photos      Photo[]
  designFiles DesignFile[]
  threads     RealizationThread[]
  workEntries WorkEntry[]

  @@index([name])
  @@index([executedAt])
  @@index([clientId])
  @@index([productType])
}

/// Zdjęcie realizacji przechowywane w Vercel Blob.
model Photo {
  id            String   @id @default(cuid())
  realizationId String
  url           String
  /// Ścieżka w Blob — potrzebna do usunięcia pliku razem z rekordem.
  pathname      String
  position      Int      @default(0)
  createdAt     DateTime @default(now())

  realization Realization   @relation(fields: [realizationId], references: [id], onDelete: Cascade)
  markers     ThreadMarker[]

  @@index([realizationId, position])
}

/// Punkt na zdjęciu wskazujący, gdzie użyto danej nici.
/// Rozwiązuje problem nici o zbliżonych kolorach, których nie da się
/// rozróżnić na fotografii.
model ThreadMarker {
  id       String @id @default(cuid())
  photoId  String
  threadId String
  /// Pozycja w procentach szerokości i wysokości zdjęcia (0–100), dzięki
  /// czemu znacznik trzyma się tego samego miejsca przy każdej wielkości podglądu.
  x        Float
  y        Float

  photo  Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)
  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([photoId])
  @@index([threadId])
}

/// Plik maszynowy (.dst/.pes/...) przechowywany w Vercel Blob.
model DesignFile {
  id            String   @id @default(cuid())
  realizationId String
  url           String
  pathname      String
  filename      String
  sizeBytes     Int
  createdAt     DateTime @default(now())

  realization Realization @relation(fields: [realizationId], references: [id], onDelete: Cascade)

  @@index([realizationId])
}

/// Nić użyta w realizacji.
model RealizationThread {
  realizationId String
  threadId      String
  /// Kolejność wyboru — z niej biorą się numery 1, 2, 3… pokazywane przy
  /// nici i na znacznikach na zdjęciu. Musi być stała, inaczej numeracja
  /// zmieniałaby się między odsłonami strony.
  position      Int     @default(0)
  note          String?

  realization Realization @relation(fields: [realizationId], references: [id], onDelete: Cascade)
  thread      Thread      @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@id([realizationId, threadId])
  @@index([threadId])
}

// ---------------------------------------------------------------------------
// Trasa pralni (aplikacja głosowa pod /pralnia). Osobne tabele od haftów:
// klienci i asortyment pralni mają „inne nazwy" do rozpoznawania mowy.
// ---------------------------------------------------------------------------

enum LaundryCatalogKind {
  CLIENT
  ITEM
}

/// Klient albo pozycja asortymentu pralni — wspólna lista dla wszystkich pracowników.
model LaundryCatalogEntry {
  id        String             @id @default(cuid())
  kind      LaundryCatalogKind
  name      String
  /// Inne nazwy i formy odmiany, po których rozpoznajemy wypowiedź.
  aliases   String[]           @default([])
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([kind, name])
}

/// Zakończona trasa. `id` nadaje telefon, dzięki czemu ponowna wysyłka po
/// utracie zasięgu nie tworzy duplikatu.
model LaundryRoute {
  id         String    @id
  /// NULL, gdyby konto kiedyś zniknęło — imię zostaje w `workerName`.
  userId     String?
  workerName String
  /// Opis urządzenia, z którego wysłano trasę (np. „Samsung SM-S918B, Android 14 · Chrome”).
  device     String?
  finishedAt DateTime
  mailedAt   DateTime?
  createdAt  DateTime  @default(now())

  user    User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  entries LaundryRouteEntry[]

  @@index([finishedAt])
}

/// Jeden wpis trasy. Nazwy zapisujemy tekstem z chwili trasy, żeby zmiana
/// albo usunięcie klienta w katalogu nie zmieniała historii.
model LaundryRouteEntry {
  id         String @id @default(cuid())
  routeId    String
  position   Int
  clientName String
  itemName   String
  quantity   Int

  route LaundryRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId, position])
}

// ---------------------------------------------------------------------------
// Rejestrator czasu pracy (/rejestrator): rozpoznawanie twarzy na tablecie,
// wejścia, wyjścia i przerwy, prace z normami, raport dnia mailem.
// Ludzie rejestratora to osobna lista od kont logowania — tablet przy drzwiach
// działa na jednym koncie, a pracownicy rozpoznawani są po twarzy.
// Znaczniki czasu `ts` i dzień `day` (YYYY-MM-DD, czas warszawski) są
// zapisywane osobno, bo urządzenia pobierają dane dniami.
// ---------------------------------------------------------------------------

/// Pracownik rejestratora z wektorami cech twarzy (nie zdjęciami).
model RcpPerson {
  id          String   @id
  name        String
  /// Lista wektorów po 128 liczb z face-api.
  descriptors Json
  createdAt   DateTime @default(now())
}

/// Rodzaj pracy z normą dzienną.
model RcpTask {
  id   String @id
  name String
  unit String
  norm Float
}

/// Wejście, wyjście, początek albo koniec przerwy.
model RcpPunch {
  id       String   @id
  /// Bez klucza obcego: wpisy zostają po usunięciu pracownika.
  personId String
  name     String
  /// in | out | break_start | break_end
  type     String
  ts       DateTime
  day      String

  @@index([day])
  @@index([personId, ts])
}

/// Wykonana praca zgłoszona przez pracownika, zatwierdzana przez kierownika.
model RcpWork {
  id         String    @id
  personId   String
  name       String
  taskId     String
  taskName   String
  unit       String
  norm       Float
  qty        Float
  ts         DateTime
  day        String
  approved   Boolean   @default(false)
  approvedAt DateTime?

  @@index([day])
}

/// Historia rozpoznań twarzy (najwyżej raz na minutę na osobę).
model RcpRecognition {
  id         String   @id
  personId   String
  name       String
  similarity Float?
  ts         DateTime
  day        String

  @@index([day])
}

/// Drobne wartości rejestratora: ustawienia raportu, hasło kierownika,
/// znacznik wysłanego raportu i licznik błędnych haseł.
model RcpSetting {
  key       String    @id
  value     String
  expiresAt DateTime?
}

/// Numery wersji, po których urządzenia co kilka sekund poznają, że coś się
/// zmieniło: `people`, `tasks`, `settings`, `last` oraz `day:YYYY-MM-DD`.
model RcpVersion {
  key   String @id
  value Int    @default(0)
}
