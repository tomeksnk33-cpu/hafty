# Skopiuj do .env i uzupełnij własnymi wartościami.

# Postgres. Lokalnie: `npm run db:start` wypisze adres.
# Produkcja: connection string z Neon (zakładka Connection Details).
DATABASE_URL="postgres://user:haslo@host/baza?sslmode=require"

# Losowy klucz podpisujący ciasteczko sesji (min. 32 znaki).
# Wygeneruj: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Hasło pierwszego administratora (tylko do pierwszego logowania — potem hasła
# są w bazie). Wygeneruj: node scripts/haslo.mjs "twoje-haslo"
# Zaloguj się loginem z ADMIN_LOGIN (domyślnie "admin") i tym hasłem.
APP_PASSWORD_HASH=""

# Opcjonalnie: login pierwszego administratora. Domyślnie "admin".
# ADMIN_LOGIN="admin"

# Token Vercel Blob (Storage > Blob > Connect Project w panelu Vercel).
# Zostaw pusty lokalnie — pliki będą zapisywane w public/uploads.
BLOB_READ_WRITE_TOKEN=""

# --- Trasa pralni (/pralnia) ---
# Odbiorca podsumowań tras (kilka adresów po przecinku). Domyślnie tomasz@gtm-bukowski.pl.
MAIL_TO="tomasz@gtm-bukowski.pl"
# Skrzynka, z której wychodzą maile z trasami (dane SMTP od dostawcy poczty).
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# Opcjonalnie nadawca, domyślnie SMTP_USER.
MAIL_FROM=""
